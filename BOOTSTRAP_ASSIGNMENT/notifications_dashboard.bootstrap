<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Notifications</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4 bg-light">
<div class="container">
<h3 class="mb-3">User Dashboard</h3>
<div class="card p-3">
<div class="alert alert-success">✅ New message received!</div>
<div class="alert alert-info">ℹ️ Tip: Update your profile.</div>
<div class="alert alert-danger alert-dismissible fade show">
⚠️ Warning: Password expires soon.
<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
<div class="bg-light border p-3 rounded">Summary: You have 3 notifications.</div>
</div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
