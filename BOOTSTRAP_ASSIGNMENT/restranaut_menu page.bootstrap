<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Menu</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4 bg-light">
<div class="container text-center">
<h2 class="mb-4">Today's Menu</h2>
<img src="https://via.placeholder.com/500x250" class="img-fluid mb-3 rounded">
<p class="lead">Delicious meals made with love!</p>
<table class="table table-bordered">
<thead class="table-dark"><tr><th>Item</th><th>Category</th><th>Price</th></tr></thead>
<tbody>
<tr><td>Margherita Pizza</td><td>Main</td><td>$12</td></tr>
<tr><td>Caesar Salad</td><td>Starter</td><td>$8</td></tr>
<tr><td>Chocolate Lava Cake</td><td>Dessert</td><td>$6</td></tr>
</tbody>
</table>
<h4 class="mt-4">Chef’s Specials</h4>
<ul class="list-group mx-auto" style="max-width:400px;">
<li class="list-group-item">Grilled Salmon</li>
<li class="list-group-item">Tandoori Chicken</li>
<li class="list-group-item">Pasta Alfredo</li>
</ul>
</div>
</body>
</html>
