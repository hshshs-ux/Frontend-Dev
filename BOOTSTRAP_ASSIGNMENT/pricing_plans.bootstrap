<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Task Tracker</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4 bg-light">
<div class="container" style="max-width:500px;">
<h3>Tasks <span class="badge bg-primary">3</span></h3>
<ul class="list-group mb-3">
<li class="list-group-item d-flex justify-content-between">Complete Report<span class="badge bg-danger">High</span></li>
<li class="list-group-item d-flex justify-content-between">Email Clients<span class="badge bg-warning text-dark">Medium</span></li>
<li class="list-group-item d-flex justify-content-between">Team Meeting<span class="badge bg-success">Low</span></li>
</ul>
<button class="btn btn-success w-100">Completed <span class="badge bg-light text-dark">1</span></button>
</div>
</body>
</html>
