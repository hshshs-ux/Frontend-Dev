<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Company Landing Page</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { font-family: Arial, sans-serif; background: #f8f9fa; }
    .hero { padding: 80px 0; background: linear-gradient(180deg, #fff, #eef2ff); }
    .hero h1 { font-weight: 700; }
    footer { background: #212529; color: white; padding: 15px 0; font-size: 0.9rem; }
  </style>
</head>
<body>
  <header class="bg-white shadow-sm">
    <nav class="navbar navbar-expand-lg container">
      <a class="navbar-brand fw-bold" href="#">InnovaTech</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Features</a></li>
          <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
        </ul>
      </div>
    </nav>
  </header>

  <section class="hero text-center">
    <div class="container">
      <h1>Empowering Your Digital Growth</h1>
      <p class="lead text-muted">We help startups scale with smart web solutions.</p>
      <a href="#" class="btn btn-primary btn-lg">Get Started</a>
    </div>
  </section>

  <footer class="text-center">&copy; 2025 InnovaTech. All rights reserved.</footer>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
