<!-- 1. Personal Portfolio Webpage Layout using Flexbox -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Personal Portfolio</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  body{font-family:Arial, sans-serif;}
  header, main, footer{padding:20px;}

  header{display:flex;justify-content:space-between;align-items:center;background:#333;color:white;}
  header nav a{color:white;margin-left:15px;text-decoration:none;}

  main{display:flex;align-items:center;justify-content:center;padding:40px;}
  .about{flex:1;padding:20px;}
  .image{flex:1;display:flex;align-items:center;justify-content:center;}
  .image img{width:80%;border-radius:10px;}

  footer{text-align:center;background:#333;color:white;padding:10px;}

  @media(max-width:700px){
    main{flex-direction:column;}
    header{flex-direction:column;}
  }
</style>
</head>
<body>
  <header>
    <h1>Your Name</h1>
    <nav>
      <a href="#">Home</a>
      <a href="#">About</a>
      <a href="#">Projects</a>
      <a href="#">Contact</a>
    </nav>
  </header>
  <main>
    <section class="about">
      <h2>About Me</h2>
      <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer euismod neque ac sapien facilisis, ac viverra sem bibendum.</p>
    </section>
    <section class="image">
      <img src="https://via.placeholder.com/400" alt="Profile">
    </section>
  </main>
  <footer>© 2025 Your Name</footer>
</body>
</html>

<!-- 2. Product Gallery using CSS Grid -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Product Gallery</title>
<style>
  body{font-family:Arial, sans-serif;padding:20px;}
  .gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  .product{background:#f0f0f0;padding:20px;text-align:center;transition:transform .3s;}
  .product:hover{transform:scale(1.05);}
  @media(max-width:900px){.gallery{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:600px){.gallery{grid-template-columns:1fr;}}
</style>
</head>
<body>
  <div class="gallery">
    <div class="product"><h3>Product 1</h3><p>$10</p></div>
    <div class="product"><h3>Product 2</h3><p>$15</p></div>
    <div class="product"><h3>Product 3</h3><p>$20</p></div>
    <div class="product"><h3>Product 4</h3><p>$25</p></div>
    <div class="product"><h3>Product 5</h3><p>$30</p></div>
    <div class="product"><h3>Product 6</h3><p>$35</p></div>
    <div class="product"><h3>Product 7</h3><p>$40</p></div>
    <div class="product"><h3>Product 8</h3><p>$45</p></div>
  </div>
</body>
</html>

<!-- 3. Homepage using Flexbox -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
