    <a href="#">Projects</a>
    <a href="#">Contact</a>
  </header>
  <main>
    <div class="box">Services</div>
    <div class="box">Projects</div>
    <div class="box">Contact</div>
  </main>
  <footer>© 2025 Your Site</footer>
</body>
</html>

<!-- 4. Dashboard using CSS Grid -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard</title>
<style>
  body{font-family:Arial,sans-serif;}
  .container{display:grid;grid-template-columns:1fr 3fr;grid-template-rows:auto 1fr;grid-template-areas:"header header""sidebar main";gap:10px;height:100vh;}
  header{grid-area:header;background:#333;color:#fff;padding:20px;text-align:center;}
  aside{grid-area:sidebar;background:#f4f4f4;padding:20px;}
  main{grid-area:main;display:grid;grid-template-columns:1fr 1fr;grid-gap:10px;}
  .box{background:#ddd;padding:20px;transition:.3s;}
  .box:hover{transform:scale(1.05);box-shadow:0 4px 8px rgba(0,0,0,0.3);}
  .span2{grid-column:span 2;}
</style>
</head>
<body>
  <div class="container">
    <header>Dashboard Header</header>
    <aside>Sidebar</aside>
    <main>
      <div class="box">Box 1</div>
      <div class="box">Box 2</div>
      <div class="box span2">Wide Box</div>
      <div class="box">Box 4</div>
    </main>
  </div>
</body>
</html>

<!-- 5. Pricing Section using Flexbox -->
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pricing</title>
<style>
  body{font-family:Arial,sans-serif;text-align:center;padding:40px;}
  .pricing{display:flex;justify-content:center;gap:20px;}
  .card{background:#f0f0f0;padding:20px;width:200px;border-radius:10px;transition:transform .3s;animation:fadeIn 1s ease;}
  .card:hover{transform:translateY(-10px);}
  .highlight{background:#aaf;transform:scale(1.1);}
  @keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
  @media(max-width:750px){.pricing{flex-direction:column;align-items:center;}}
</style>
</head>
<body>
  <div class="pricing">
    <div class="card">Basic</div>
    <div class="card highlight">Pro</div>
    <div class="card">Enterprise</div>
  </div>
</body>
</html>

<!-- 6. Blog Layout using CSS Grid -->
<!DOCTYPE html>
